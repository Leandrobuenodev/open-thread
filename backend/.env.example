# Set the real HTTPS Foundry resource root (not a project or API path).
# A deployment supporting v1 Chat Completions is required; no default is assumed.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
# FRONTEND_ORIGIN=http://localhost:5173

# Microsoft Entra ID (use the v2.0 authority for the tenant that issued API tokens).
ENTRA_AUTHORITY=https://login.microsoftonline.com/replace-with-tenant-id/v2.0
# For v2.0 access tokens this is the API app registration's client ID.
ENTRA_API_AUDIENCE=replace-with-api-application-client-id
# Scope name only, matching the delegated scope's `scp` claim value.
ENTRA_REQUIRED_SCOPE=replace-with-scope-name

# Optional runtime identity exposed by GET /health/version. These values are
# safe release metadata, not secrets. Leave unset when unavailable.
# APP_GIT_SHA=
# APP_BUILD_ID=
# APP_RELEASE_ID=
# APP_ENVIRONMENT=
# APP_IMAGE_DIGEST=
# APP_MIGRATION_REVISION=

# Azure Container Apps supplies these automatically at runtime; leave unset locally.
# CONTAINER_APP_REVISION=
# CONTAINER_APP_REPLICA_NAME=
# CONTAINER_APP_HOSTNAME=

# Release readiness detections remain non-failing during this rollout window.
# Legacy release-intelligence experiment; not used by the current chat runtime.
# RELEASE_DETECTION_GRACE_MINUTES=5

# Optional process-local DEV chat protection (positive integers; restart to apply).
# Counters are not shared across workers/replicas. See README for the token budget.
# CHAT_RATE_LIMIT_REQUESTS=5
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# CHAT_MAX_CONCURRENCY=1
# CHAT_MAX_BODY_BYTES=65536
# CHAT_MAX_MESSAGE_BYTES=512
# FOUNDRY_MAX_OUTPUT_TOKENS=256

# Local emulator only. No cloud keys; Azurite uses its public development credentials.
STORAGE_AUTH_MODE=azurite
STORAGE_TABLE_NAME=OpenThreadWorkspace
STORAGE_BLOB_CONTAINER=attachments
# AZURITE_CONNECTION_STRING=... # Optional explicit LOOPBACK Table + Blob endpoints.
# Azure DEV: STORAGE_AUTH_MODE=managed_identity (DefaultAzureCredential).
# STORAGE_ACCOUNT_NAME=...
# STORAGE_TABLE_ENDPOINT=https://ACCOUNT.table.core.windows.net
# STORAGE_BLOB_ENDPOINT=https://ACCOUNT.blob.core.windows.net

# Bounded context; include current prompt. Byte budget must fit CHAT_MAX_MESSAGE_BYTES.
# CHAT_CONTEXT_MAX_MESSAGES=20
# CHAT_CONTEXT_MAX_BYTES=16384
# Conservative per-request DEV estimate, including framing, input and output.
# CHAT_TOKEN_BUDGET=1000
# CHAT_TOKEN_SAFETY_MARGIN=100
