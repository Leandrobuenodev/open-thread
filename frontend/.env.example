# Frontend API base URL.
VITE_API_BASE_URL=http://localhost:8000

# Microsoft Entra ID SPA registration and the API delegated scope.
VITE_ENTRA_CLIENT_ID=replace-with-spa-application-client-id
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/replace-with-tenant-id/v2.0
# Register this exact URL as a Single-page application redirect URI.
# MSAL v5 uses this dedicated page as the popup redirect bridge.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/redirect.html
# Full scope string: <API Application ID URI>/<scope-name>
VITE_ENTRA_API_SCOPE=replace-with-full-api-scope
